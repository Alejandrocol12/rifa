# Copia este archivo a .env para desarrollo local, o define estas mismas
# variables en el panel de tu plataforma de despliegue (Railway, Render, etc.)

# Obligatoria en cualquier despliegue real (la app no arranca sin ella si
# detecta DATABASE_URL). Genera una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Cadena de conexión a PostgreSQL. En Railway, la generan automáticamente al
# agregar el plugin de PostgreSQL a tu proyecto (variable ${{Postgres.DATABASE_URL}}
# o similar) — cópiala desde ahí, no la inventes a mano.
DATABASE_URL=

# Ayuda a que el comando `flask` encuentre la app sin adivinar.
FLASK_APP=app.py
